# === Application ===
APP_NAME=Agent Orchestrator
DEBUG=false

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/orchestrator

# === Redis ===
REDIS_URL=redis://redis:6379

# === LLM - Planning Tier ===
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === LLM - Execution Tier ===
EXECUTION_LLM_URL=http://ollama:11434
EXECUTION_LLM_MODEL=qwen2.5-coder:32b
OPENROUTER_API_KEY=

# === Security ===
# REQUIRED: Must be at least 32 characters
# Generate with: openssl rand -hex 32
API_KEY=your-secure-api-key-at-least-32-characters-long

# === CORS ===
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# === Cost Management ===
DAILY_BUDGET_USD=5.0
